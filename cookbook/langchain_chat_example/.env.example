# Environment variables for LangChain Chat Application

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# Or use a complete Redis URL (overrides individual settings above)
REDIS_URL=redis://localhost:6379/0

# LLM Configuration (ChatTongyi/Qwen)
DASHSCOPE_API_KEY=your-api-key-here
LLM_MODEL=qwen-turbo
LLM_TEMPERATURE=0.3

# Optional: API Configuration
# API_TITLE=LangChain Chat API with Memory
# API_VERSION=1.0.0
